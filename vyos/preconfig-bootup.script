#!/bin/sh
# Runs at boot before the VyOS config is applied.
# Docker disables IPv6 per interface (VyOS needs link-local addresses) and
# assigns its own IPv4 addresses; undo both so VyOS owns the interfaces.
for path in /sys/class/net/eth*; do
    ifname=${path##*/}
    sysctl -qw net.ipv6.conf.$ifname.disable_ipv6=0
    ip -4 addr flush dev $ifname
done

# nftables `destroy` needs host kernel 6.3+; on older kernels every interface
# commit fails ("Could not process rule: Invalid argument"). Rewrite it with
# add + delete (same effect: remove if present). The rpfilter_strict map's
# elements always map to `accept`.
tmpl=/usr/share/vyos/templates/firewall/nftables-source-validation.j2
sed -i \
    -e 's/^destroy rule /delete rule /' \
    -e 's/^destroy element \(.*\) rpfilter_strict { \(.*\) }$/add element \1 rpfilter_strict { \2 : accept }\ndelete element \1 rpfilter_strict { \2 }/' \
    -e 's/^destroy element \(.*\) { \(.*\) }$/add element \1 { \2 }\ndelete element \1 { \2 }/' \
    "$tmpl"

# Fallback for hosts where FRR fails to install the DHCP default route.
# Copied (not mounted) because /config is a non-recursive bind of this dir.
install -D -m 0755 /opt/vyatta/etc/dhcp-default-route.hook \
    /opt/vyatta/etc/config/scripts/dhcp-client/post-hooks.d/50-default-route

# On a fresh config volume only (so saved changes persist; `make wipe-<gw>`
# resets the volume): seed the lab config if one is mounted, otherwise just set
# host-name to the container's hostname. VyOS can't change the hostname Docker
# sets, so a mismatch makes sudo warn "unable to resolve host".
config=/opt/vyatta/etc/config/config.boot
seed=/opt/vyatta/etc/config.boot.lab
marker=/opt/vyatta/etc/config/.lab-seeded
if [ ! -e "$marker" ]; then
    if [ -f "$seed" ]; then
        cp "$seed" "$config"
    else
        sed -i "s/^\(    host-name \)\"vyos\"$/\1\"$(hostname)\"/" "$config"
    fi
    touch "$marker"
fi
